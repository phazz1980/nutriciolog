<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 otherwise enforces edge-to-edge for targetSdk 35, placing
         the WebView content below the status bar. The web client is not yet
         edge-to-edge aware on Android, so keep system bar insets native. -->
    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Keep the normal no-action-bar properties in this API-specific
             resource too. Otherwise Android treats this as a new bare style
             and draws an empty blue AppCompat toolbar above the WebView. -->
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
